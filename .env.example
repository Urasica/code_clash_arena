# Docker Compose development infrastructure
MYSQL_DATABASE=code_arena
DATABASE_USERNAME=cca
DATABASE_PASSWORD=cca_dev
MYSQL_ROOT_PASSWORD=cca_root_dev
MYSQL_PORT=3306
REDIS_PORT=6379

# Spring Boot runtime (export these in the shell or configure them in the IDE)
DATABASE_URL=jdbc:mysql://localhost:3306/code_arena?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
REDIS_HOST=localhost
FRONTEND_URL=http://localhost:3000
ENGINE_IMAGE=code-battle-engine
ENGINE_READINESS_TIMEOUT=3s
ENGINE_WORKSPACE=temp
ENGINE_WORKSPACE_IDLE_TTL=30m
ENGINE_WORKSPACE_CLEANUP_ENABLED=true
ENGINE_WORKSPACE_CLEANUP_INITIAL_DELAY=1m
ENGINE_WORKSPACE_CLEANUP_INTERVAL=5m
MATCH_QUEUE_POLL_INTERVAL=1s
MATCH_RECONNECT_GRACE=5s
MATCH_EXECUTOR_CORE_SIZE=2
MATCH_EXECUTOR_MAX_SIZE=4
MATCH_EXECUTOR_QUEUE_CAPACITY=20
MANAGEMENT_PORT=8081

# Required outside local development. Use at least 32 random bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
SECURITY_REQUIRE_ORIGIN=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_LOGIN=10
RATE_LIMIT_GUEST=5
RATE_LIMIT_COMPILE=20
RATE_LIMIT_RUN=10
GUEST_TTL=24h
GUEST_CLEANUP_INTERVAL=1h

# Optional Google OAuth registration
# Keep real values only in the ignored .env file or an external secret store.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_SCOPE=profile,email
