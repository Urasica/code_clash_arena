{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || >=24.15.0 <25",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.8.4",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "sockjs-client": "^1.6.1"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "start:e2e": "node e2e/serve-build.js",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "audit": "npm audit --audit-level=high",
    "audit:runtime": "npm audit --omit=dev --audit-level=high"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "3.4.13"
  }
}
